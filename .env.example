# Skopiuj ten plik do .env i wklej prawdziwy klucz.
# Klucz weź z Google AI Studio: https://aistudio.google.com/apikey
# WAŻNE: prefiks EXPO_PUBLIC_ jest wymagany — bez niego Expo nie wbuduje
# zmiennej do bundla JS i process.env.EXPO_PUBLIC_GEMINI_API_KEY będzie undefined.
EXPO_PUBLIC_GEMINI_API_KEY=
